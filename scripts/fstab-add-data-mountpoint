#!/bin/sh
set -eu

target=/run/media/chxei/data
source=PARTLABEL=data
entry="$source $target ext4 rw,users,exec 0 0"

if [ "$(blkid -p -s TYPE -o value /dev/disk/by-partlabel/data)" != ext4 ]; then
    echo "Expected an ext4 partition with PARTLABEL=data. Check lsblk -o NAME,PARTLABEL,FSTYPE." >&2
    exit 1
fi

if mountpoint -q "$target" && ! findmnt --mountpoint "$target" --source "$source" >/dev/null; then
    echo "Another filesystem is mounted at $target." >&2
    exit 1
fi

# Keep concurrent runs from both appending the same entry.
exec 9</etc/fstab
flock -x 9
if existing=$(findmnt --fstab --mountpoint "$target" --raw --noheadings \
        --output SOURCE,TARGET,FSTYPE,OPTIONS,FREQ,PASSNO); then
    if [ "$existing" != "$entry" ]; then
        echo "Conflicting fstab entry for $target: $existing" >&2
        exit 1
    fi
else
    printf '\n%s\n' "$entry" | tee -a /etc/fstab
fi

mkdir -p "$target"
systemctl daemon-reload
mountpoint -q "$target" || mount "$target"
findmnt --mountpoint "$target" --source "$source" --output SOURCE,TARGET,FSTYPE,OPTIONS
