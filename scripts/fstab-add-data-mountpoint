#!/bin/sh
set -eu

target=/run/media/chxei/data
source=PARTLABEL=data
options=rw,users,exec
entry="$source $target ext4 $options 0 0"

if [ "$(blkid -p -s TYPE -o value /dev/disk/by-partlabel/data)" != ext4 ]; then
    echo "Expected an ext4 partition with PARTLABEL=data." >&2
    exit 1
fi

# Lock the table so two runs cannot add the same entry.
exec 9</etc/fstab
flock -x 9
mkdir -p "$target"
findmnt --verify --tab-file /etc/fstab
existing=$(findmnt --fstab --mountpoint "$target" --raw --noheadings \
    --output SOURCE,TARGET,FSTYPE,OPTIONS,FREQ,PASSNO) || existing=
if [ -n "$existing" ] && [ "$existing" != "$entry" ]; then
    echo "Conflicting fstab entry for $target: $existing" >&2
    exit 1
fi

# Verify the live mount before committing it to the boot configuration.
mountpoint -q "$target" || mount -t ext4 -o "$options" "$source" "$target"
findmnt --mountpoint "$target" --source "$source" --output SOURCE,TARGET,FSTYPE,OPTIONS

if [ -z "$existing" ]; then
    printf '\n%s\n' "$entry" >> /etc/fstab
fi
systemctl daemon-reload
